{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Handcrafted wood products"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "shortDescription": {
      "type": "text"
    },
    "subcategory": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::subcategory.subcategory",
      "inversedBy": "products"
    },
    "sizeOptions": {
      "type": "json"
    },
    "filters": {
      "type": "component",
      "repeatable": true,
      "component": "product.filter"
    },
    "minQuantity": {
      "type": "integer",
      "default": 1
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "cloudinaryPublicId": {
      "type": "string",
      "unique": true,
      "private": true
    }
  }
}
